NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Trust only the known Nginx proxy hop (set TRUST_PROXY=1 when actually behind it).
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=elite_convention_hall
DB_USER=elite_app
DB_PASSWORD=REPLACE_WITH_LOCAL_MYSQL_PASSWORD
DB_CONNECTION_LIMIT=5

# Generate a unique secret: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Required in production; NEVER commit the actual value.
SESSION_SECRET=
# Local admin frontend in development; use the real HTTPS origin in production.
ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:5174
